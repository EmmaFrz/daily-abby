# Puerto del servidor del juego
PORT=3001

# Clave para entrar a /host y /abby (cámbiala antes de usarlo en directo)
HOST_KEY=cambia-esta-clave

# Canal de Twitch cuyo chat se lee (sin #)
TWITCH_CHANNEL=littleragergirl

# Fuente del chat al arrancar: simulator | twitch | off
# (se puede cambiar en vivo desde /host)
CHAT_SOURCE=simulator

# Retraso aproximado del stream en segundos.
# El chat ve todo con este retraso, así que recibe este tiempo extra para votar.
STREAM_DELAY_SEC=4

# Cuántos espectadores falsos genera el simulador
SIM_VIEWERS=300
